---
import SelectedWriting from "@components/SelectedWriting.astro";
import ClayCard from "@components/ClayCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatDate, getPublishedPosts } from "@lib/content";

const posts = await getPublishedPosts();
const tones = ["indigo", "mint", "rose"] as const;
---

<BaseLayout title="Blog | Khalil Nooh">
  <section class="section-heading">
    <div>
      <span class="eyebrow">Blog</span>
      <h1>Ideas worth<br />working through.</h1>
    </div>
    <p>Selected posts from LinkedIn and Facebook, alongside longer essays and research notes.</p>
  </section>

  <SelectedWriting />
  <div class="archive-intro"><h2>Essays &amp; working notes</h2><p>Longer explorations from the archive, with links to their sources.</p></div>
  <section class="grid">
    {posts.map((post, index) => (
      <ClayCard tone={tones[index % tones.length]} href={`/blog/${post.slug}/`} data-enter>
        <p class="timeline-date">{formatDate(post.data.publishedAt)}</p>
        <h2>{post.data.title}</h2>
        <p>{post.data.summary}</p>
        <div class="tag-row">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
      </ClayCard>
    ))}
  </section>
</BaseLayout>
