---
import ArrowIcon from "@components/ArrowIcon.astro";
import ClayCard from "@components/ClayCard.astro";
import VideoPreview from "@components/VideoPreview.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { press } from "../../data/editorial";
const sources = [...new Set(press.map(item => item.publisher))];
// Lead with the Tatler cover story and Fortune; retain year order for the rest.
const featuredCoverage = press.slice(0, 2);
const coverage = [...featuredCoverage, ...press.slice(2).sort((a, b) => Number(b.year) - Number(a.year))];
---
<BaseLayout title="Media | Khalil Nooh" description="Interviews, reviews, and coverage of Khalil Nooh, Mesolitica, MaLLaM, and The Future Is Solo from Malaysian and regional media, including Tatler Asia, Fortune, The Star, NST, Astro AWANI, and The Edge.">
  <section class="section-heading"><div><p class="eyebrow">In the media</p><h1>Stories beyond<br />my own words.</h1></div><p>Interviews, published essays, and coverage of the work. Read each story at its original publication.</p></section>
  <VideoPreview />
  <div class="section-heading media-coverage-heading" id="coverage"><div><p class="eyebrow">Published perspectives</p><h2>In print &amp; online.</h2></div></div>
  <ClayCard tone="plain" class="filter-panel"><div class="filter-row"><button type="button" data-media-filter="all" aria-pressed="true">All</button>{sources.map(source => <button type="button" data-media-source={source} aria-pressed="false">{source}</button>)}</div><p class="filter-summary" data-media-count aria-live="polite">{press.length} media items shown</p></ClayCard>
  <ClayCard tone="plain" class="empty-state" data-empty-state hidden><h2>No matching coverage</h2><p>Choose All to see every publication.</p></ClayCard>
  <section class="grid two">{coverage.map(item => <ClayCard class="media-item" data-source={item.publisher} data-enter><div class="press-publisher"><span>{item.publisher}</span><small>{item.category} / {item.year}</small></div><h2>{item.title}</h2><p>{item.summary}</p><div class="tag-row"><span class="tag">{item.topic}</span></div><a class="button" href={item.url}>{item.category === "Video interview" ? "Watch at" : "Read at"} {item.publisher} <ArrowIcon /></a></ClayCard>)}</section>
  <script>
    const mediaItems = [...document.querySelectorAll(".media-item")];
    const mediaCount = document.querySelector("[data-media-count]");
    const mediaEmptyState = document.querySelector("[data-empty-state]");
    const mediaAllButton = document.querySelector("[data-media-filter='all']");
    const mediaSourceButtons = [...document.querySelectorAll("[data-media-source]")];
    let activeSource = "";

    function applyMediaFilter() {
      let visibleCount = 0;
      mediaItems.forEach((item) => {
        if (!(item instanceof HTMLElement)) return;
        const isVisible = !activeSource || item.dataset.source === activeSource;
        item.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      if (mediaCount) mediaCount.textContent = `${visibleCount} ${visibleCount === 1 ? "media item" : "media items"} shown`;
      if (mediaEmptyState instanceof HTMLElement) mediaEmptyState.hidden = visibleCount !== 0;
      if (mediaAllButton instanceof HTMLElement) mediaAllButton.setAttribute("aria-pressed", activeSource ? "false" : "true");
      mediaSourceButtons.forEach((button) => {
        if (!(button instanceof HTMLElement)) return;
        button.setAttribute("aria-pressed", button.dataset.mediaSource === activeSource ? "true" : "false");
      });
    }

    mediaSourceButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (!(button instanceof HTMLElement)) return;
        activeSource = activeSource === button.dataset.mediaSource ? "" : button.dataset.mediaSource || "";
        applyMediaFilter();
      });
    });
    mediaAllButton?.addEventListener("click", () => {
      activeSource = "";
      applyMediaFilter();
    });
    applyMediaFilter();
  </script>
</BaseLayout>
