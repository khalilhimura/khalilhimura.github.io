---
import ArrowIcon from "@components/ArrowIcon.astro";
import { portrait } from "../../data/images";
import BaseLayout from "@layouts/BaseLayout.astro";
import { currentWork, socials, tatlerProfile } from "../../data/editorial";
---
<BaseLayout title="Profile | Khalil Nooh" description="From Mesolitica and MaLLaM to The Future Is Solo. Meet Khalil Nooh, an AI builder, educator, and perpetually curious Malaysian.">
  <section class="profile-hero">
    <div><p class="eyebrow">A little about me</p><h1>Always curious.<br />Always building.</h1><p class="lead">I'm Khalil Nooh, a Malaysian AI builder and educator exploring how people can create more with the knowledge they already have.</p><div class="tag-row"><a class="button primary" href={socials.linkedin}>Connect on LinkedIn <ArrowIcon /></a><a class="text-link" href={socials.facebook}>Find me on Facebook <ArrowIcon /></a></div></div>
    <figure class="hero-portrait"><img src={portrait.url} width={portrait.width} height={portrait.height} alt={portrait.alt} /><figcaption><span>Khalil Nooh</span></figcaption></figure>
  </section>
  <section class="profile-body">
    <div><p class="eyebrow">Where I come from</p><h2>AI should understand<br />its people.</h2><p>As co-founder of Mesolitica, I helped build the business behind MaLLaM, a language model shaped around Malaysian languages, dialects, and culture.</p><p>That work brought together local language research, open-source models, partnerships, and practical applications. It also made one thing clear: access to technology matters most when people can actually use it.</p><a class="text-link" href={tatlerProfile.url}>Read the Mesolitica story in Tatler <ArrowIcon /></a></div>
    <div><p class="eyebrow">What I'm exploring now</p><h2>What can one<br />person build?</h2><p>The Future Is Solo is my exploration of independent work in the age of AI. I build and test the idea through experiments, writing, and participation in the Malaysian.ai AI residency.</p><p>The Solo Systems Architect (SSA) is the person who directs the work, designs the system, and takes responsibility for the result. The SSA-CMM provides a way to reflect on how that capability develops.</p><a class="text-link" href="https://thefutureissolo.com/">Explore The Future Is Solo <ArrowIcon /></a></div>
  </section>
  <section class="profile-body">
    <div><p class="eyebrow">What I believe</p><h2>Independence and<br />community belong together.</h2><p>Good systems create room for judgment, relationships, and meaningful work. They also make it easier to ask for help, learn from others, and contribute something useful.</p><p>My public writing moves between the technical and the personal: experiments with AI agents, lessons from building, music made with AI, and the people who make the journey worthwhile.</p><a class="text-link" href="/blog/">Explore my writing <ArrowIcon direction="right" /></a></div>
    <div><p class="eyebrow">A place to start</p><h2>Follow your curiosity.</h2>{currentWork.map(work => <p><a class="text-link" href={work.url}>{work.title} <ArrowIcon /></a><br />{work.detail}</p>)}</div>
  </section>
</BaseLayout>
