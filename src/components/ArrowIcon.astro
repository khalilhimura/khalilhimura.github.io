---
interface Props {
  direction?: "up-right" | "right" | "left";
}
const { direction = "up-right" } = Astro.props;
const paths = {
  "up-right": "M5 19 19 5M5 5h14v14",
  right: "M4 12h16M13 5l7 7-7 7",
  left: "M20 12H4M11 5l-7 7 7 7",
};
---
<svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[direction]} /></svg>
